NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=wxpense
DB_PASSWORD=wxpense
DB_NAME=wxpense

# Use migrations in production; true only for quick local prototyping
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Security
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
